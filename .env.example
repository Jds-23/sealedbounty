# NEAR AI Cloud
NEARAI_API_KEY=<your-nearai-cloud-key>
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.8-27B
NEARAI_SIGNING_ALGO=ed25519

# NEAR chain
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_TESTNET_ACCOUNT_ID=<you>.testnet
NEAR_CREDENTIALS_PATH=~/.near-credentials/testnet/<you>.testnet.json
NEAR_MAINNET_PAYOUT_ACCOUNT=<you>.near
CONTRACT_ID=sealedbounty.<you>.testnet
