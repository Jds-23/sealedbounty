# Copy to .env (repo root). Nothing here is needed for the read-only commands, `make demo`,
# `make verify-offline`, `make attest` or the tests; the CLI and web default to the v2 contract
# sealedbounty-v3.testnet and the FastNEAR testnet RPC.

# NEAR AI Cloud (only for a live judgement: `sb submit` without --fixture)
NEARAI_API_KEY=<your-nearai-cloud-key>
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=Qwen/Qwen3.8-27B
NEARAI_SIGNING_ALGO=ed25519

# NEAR chain
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Signer for write commands. For `sb submit` this account is also the HUNTER line bound into the judge request.
NEAR_TESTNET_ACCOUNT_ID=<you>.testnet
NEAR_CREDENTIALS_PATH=~/.near-credentials/testnet/<you>.testnet.json
NEAR_MAINNET_PAYOUT_ACCOUNT=<you>.near

# Escrow contract (v2: code_hash + hunter binding). v1 history: escrow.baldingsucks7993.testnet
ESCROW_CONTRACT_ID=sealedbounty-v3.testnet
# Phase 0 spike contract (spike/ only; the CLI ignores CONTRACT_ID)
CONTRACT_ID=sealedbounty.<you>.testnet
